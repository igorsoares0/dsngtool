// Prisma schema for Modo. The app keeps every design on the user's device; the
// server only records licenses, so it can deliver keys and answer "has this
// one been refunded?".
// Runtime uses DATABASE_URL (Neon pooled); migrations use DIRECT_URL (Neon direct).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per sold license. The signed key itself is not stored: Ed25519 is
// deterministic, so the key can always be re-derived from (id, source) with the
// private key — which keeps a DB leak from leaking usable keys.
model License {
  // 16-char Crockford base32; embedded in the signed key (app/lib/license/format.ts).
  id         String    @id
  source     String // "paddle" | "appsumo" | "manual"
  // Paddle transaction id, AppSumo license_key, or a note for manual keys.
  externalId String    @unique
  email      String?
  // "active" | "revoked" (refund, AppSumo deactivate).
  status     String    @default("active")
  // AppSumo tier ("tier" from their webhook); null elsewhere.
  tier       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  @@index([email])
}
